# =========================================
# Application
# =========================================
NODE_ENV=production
PORT=5000

DATABASE_URL=postgresql://postgres:postgres@postgres:5432/visitor_management

FASTAPI_URL=http://recognition-backend:8000

JWT_SECRET=your-super-secret-jwt-keys
JWT_EXPIRES_IN=7d

# =========================================
# Qdrant
# =========================================
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=persons
QDRANT_VECTOR_SIZE=512

FACE_MATCH_THRESHOLD=0.65
FACE_DUPLICATE_THRESHOLD=0.90

# =========================================
# Logging
# =========================================
LOG_LEVEL=info
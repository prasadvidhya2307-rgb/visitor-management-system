FROM node:22-alpine

WORKDIR /app

# Needed for prisma generate + some native deps on alpine
RUN apk add --no-cache openssl libc6-compat

COPY apps/backend/package*.json ./
RUN npm install

COPY apps/backend .

# Generate prisma client into node_modules/.prisma so it exists
# even though bind-mount will overlay /app with host source
RUN npx prisma generate

EXPOSE 5000

CMD ["npm", "run", "dev"]